# Production Environment Variables for Vercel Deployment

# API Configuration - Replace with your actual Render backend URL
NEXT_PUBLIC_API_URL=https://url-shortener-h4gc.onrender.com

# Environment
NODE_ENV=production

# Optional: Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id

# Optional: Error Tracking (Sentry, etc.)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn